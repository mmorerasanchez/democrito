{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://democrito.design/showcase/showcase.schema.json",
  "title": "democrito Showcase",
  "description": "Schema for the democrito showcase — systems built on democrito, their divergence verdicts, and what the contract held or broke.",
  "type": "object",
  "required": ["base", "spectrum", "systems", "whatWeLearned", "submit"],
  "additionalProperties": false,
  "properties": {
    "$schema":   { "type": "string" },
    "generated": { "type": "string" },
    "intro": {
      "type": "object",
      "required": ["heading", "body", "note"],
      "properties": {
        "heading": { "type": "string" },
        "body":    { "type": "string" },
        "note":    { "type": "string" }
      }
    },
    "base": {
      "type": "object",
      "description": "The democrito baseline values being compared against.",
      "required": ["name", "version", "theme", "valueFormat", "tokens", "fonts", "themes", "components"],
      "properties": {
        "name":        { "type": "string" },
        "version":     { "type": "string" },
        "theme":       { "type": "string" },
        "valueFormat": { "type": "string" },
        "tokens":      { "type": "object" },
        "fonts":       { "type": "object" },
        "themes":      { "type": "array", "items": { "type": "string" } },
        "components":  { "type": "object" }
      }
    },
    "spectrum": {
      "type": "object",
      "required": ["axis", "note"],
      "properties": {
        "axis": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["pure-retheme", "retheme-additions", "partial-fork", "rewrite"]
          }
        },
        "note":             { "type": "string" },
        "axisLabels":      { "type": "object", "additionalProperties": { "type": "string" } },
        "axisDefinitions": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "systems": {
      "type": "array",
      "items": { "$ref": "#/$defs/system" }
    },
    "prototypes": {
      "type": "object",
      "required": ["sectionTitle", "sectionNote", "verificationLevel", "systems"],
      "properties": {
        "sectionTitle": { "type": "string" },
        "sectionNote":  { "type": "string" },
        "verificationLevel": {
          "type": "string",
          "enum": ["self-declared", "source-audited"]
        },
        "systems": {
          "type": "array",
          "items": { "$ref": "#/$defs/prototypeSystem" }
        }
      }
    },
    "whatWeLearned": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "body", "evidence"],
        "properties": {
          "title":    { "type": "string" },
          "body":     { "type": "string" },
          "evidence": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "submit": {
      "type": "object",
      "required": ["headline", "body", "cta", "email", "subject", "bodyTemplate"],
      "properties": {
        "headline":     { "type": "string" },
        "body":         { "type": "string" },
        "cta":          { "type": "string" },
        "email":        { "type": "string", "format": "email" },
        "subject":      { "type": "string" },
        "bodyTemplate": { "type": "string" }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  },
  "$defs": {
    "systemShape": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "name":       { "type": "string" },
        "tagline":    { "type": "string" },
        "url":        { "type": "string", "format": "uri" },
        "screenshot": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["live", "prototype", "private", "alpha"]
        },
        "year":     { "type": "integer" },
        "builtBy":  { "type": "string" },
        "headline": { "type": "string" },
        "divergence": {
          "type": "object",
          "required": ["verdict", "evidence"],
          "properties": {
            "verdict": {
              "type": "string",
              "enum": ["pure-retheme", "retheme-additions", "partial-fork", "rewrite"]
            },
            "evidence":             { "type": "string" },
            "componentsEdited":     { "type": "array", "items": { "type": "string" } },
            "componentsAdded":      { "type": "integer" },
            "primitivesAudited":    { "type": "string" },
            "primitivesUnverified": { "type": "integer" },
            "coverageNote":         { "type": "string" }
          }
        },
        "tokens": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/tokenEntry" }
        },
        "added": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "themes": {
          "type": "object",
          "properties": {
            "count":     { "type": "integer" },
            "default":   { "type": "string" },
            "mechanism": { "type": "string" },
            "note":      { "type": "string" }
          }
        },
        "vignette": { "$ref": "#/$defs/vignette" },
        "extendedPalette": { "type": "object" },
        "kept":       { "type": "array", "items": { "type": "string" } },
        "overridden": { "type": "array", "items": { "type": "string" } },
        "recipe":     { "type": "string" },
        "contractNotes": {
          "type": "object",
          "required": ["held", "broke"],
          "properties": {
            "held":  { "type": "array", "items": { "type": "string" } },
            "broke": { "type": "array", "items": { "type": "string" } }
          }
        },
        "warnings":           { "type": "array", "items": { "type": "string" } },
        "tokensInherited":    { "type": "array", "items": { "type": "string" } },
        "tokensInheritedNote": { "type": "string" },
        "renamed":            { "type": "object" },
        "renamedNote":        { "type": "string" },
        "components":         { "type": "object" }
      }
    },
    "system": {
      "allOf": [{ "$ref": "#/$defs/systemShape" }],
      "required": ["slug", "name", "tagline", "status", "year", "builtBy", "divergence", "tokens", "vignette", "contractNotes", "kept", "overridden", "recipe"]
    },
    "prototypeSystem": {
      "allOf": [{ "$ref": "#/$defs/systemShape" }],
      "required": ["slug", "name", "tagline", "status", "year", "builtBy", "divergence", "tokens", "contractNotes", "recipe"]
    },
    "tokenEntry": {
      "type": "object",
      "required": ["base"],
      "properties": {
        "base":   { "type": "string" },
        "system": { "type": ["string", "null"] },
        "note":   { "type": "string" }
      }
    },
    "vignette": {
      "type": "object",
      "required": ["defaultTheme", "valueFormat", "resolved", "absent", "fonts"],
      "properties": {
        "defaultTheme": { "type": "string" },
        "valueFormat": {
          "type": "string",
          "enum": ["bare-triplet", "hsl-function"]
        },
        "valueFormatWarning": { "type": "string" },
        "resolved": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "absent": {
          "type": "array",
          "items": { "$ref": "#/$defs/absentEntry" }
        },
        "absentSummary":     { "type": "string" },
        "beyondListNote":    { "type": "string" },
        "fonts":             { "type": "object" },
        "scaleWarning":      { "type": "string" },
        "unreproducible":    { "type": "array", "items": { "type": "string" } },
        "bareRoundedCount":  { "type": "integer" },
        "bareRoundedNote":   { "type": "string" },
        "excludeComponents": { "type": "array", "items": { "type": "string" } }
      }
    },
    "absentEntry": {
      "type": "object",
      "required": ["token", "substitutedWith", "consequence", "mode", "renderValue"],
      "properties": {
        "token":           { "type": "string" },
        "substitutedWith": { "type": ["string", "null"] },
        "consequence":     { "type": "string", "minLength": 1 },
        "mode":            { "type": "string", "enum": ["substituted", "approximated", "excluded"] },
        "renderValue":     { "type": ["string", "null"] }
      },
      "if": {
        "properties": { "mode": { "not": { "const": "excluded" } } },
        "required": ["mode"]
      },
      "then": {
        "properties": { "renderValue": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
